{
    "name": "@daemon/eliza-l402",
    "version": "0.1.0",
    "description": "Eliza plugin for L402 pay-per-call API payments",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "eliza",
        "l402",
        "lightning",
        "bitcoin",
        "ai-agent",
        "payment"
    ],
    "author": "Daemon Team",
    "license": "MIT",
    "peerDependencies": {
        "@elizaos/core": ">=1.0.0"
    },
    "dependencies": {},
    "devDependencies": {
        "@elizaos/core": "^1.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^1.2.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}