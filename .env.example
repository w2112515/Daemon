# ============================================================
# Daemon L402 - Environment Configuration Template
# 来源: Vol.0 §3.1 Secrets Schema
# ============================================================
# 使用方式: 复制此文件为 .env，填充所有必需值
# cp .env.example .env
# ============================================================

# ============================================================
# Lightning Network Daemon (LND)
# ============================================================

# LND 网络模式: regtest (本地开发) / signet (测试网) / mainnet (生产)
LND_NETWORK=regtest

# LND 运行模式: mock (模拟Invoice,默认) / real (连接真实LND gRPC)
# D-H-06: mock模式会在启动日志中显示警告
LND_MODE=mock

# 从 LND 容器提取: docker exec lnd xxd -p -c 10000 /root/.lnd/data/chain/bitcoin/${LND_NETWORK}/admin.macaroon
LND_MACAROON_HEX=

# TLS 证书路径 (容器内路径，通常不需修改)
LND_TLS_CERT_PATH=/root/.lnd/tls.cert

# LND 端口配置
LND_GRPC_PORT=10009
LND_REST_PORT=8080

# ============================================================
# Bitcoin Core (Regtest)
# ============================================================
BITCOIND_RPC_PORT=18443
BITCOIND_ZMQ_BLOCK=28332
BITCOIND_ZMQ_TX=28333

# ============================================================
# L402 Gateway
# ============================================================

# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
L402_SECRET_KEY=

# 每次 API 调用成本 (1 Satoshi = 1000 msats)
INVOICE_PRICE_MSATS=1000

# Gateway 端口
GATEWAY_PORT=3000

# ============================================================
# AI Agent 钱包
# ============================================================

# BIP39 助记词 (12 words)
# 开发环境可使用测试种子: abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
AGENT_SEED_PHRASE=

# Agent 预算限制 (satoshis)
BUDGET_LIMIT_SATS=10000

# 每小时支出限额 (msats) - 风控
HOURLY_LIMIT_MSATS=100000

# 大额支付预警阈值 (msats) - 风控
LARGE_PAYMENT_THRESHOLD_MSATS=50000

# Agent API 端口
AGENT_API_PORT=5000

# ============================================================
# Database (PostgreSQL)
# ============================================================

# 强密码 (禁止使用 'password')
POSTGRES_PASSWORD=

# 端口映射 (避免与本地 PostgreSQL 冲突)
POSTGRES_PORT=5433

# ============================================================
# Redis (Macaroon 缓存)
# ============================================================

# 可选 (生产环境强制启用)
REDIS_PASSWORD=

REDIS_PORT=6379

# ============================================================
# Rate Limiting (Task-P2-01)
# ============================================================

# 限流时间窗口 (毫秒，默认 60000 = 1分钟)
RATE_LIMIT_WINDOW_MS=60000

# 窗口内最大请求数 (默认 100)
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Root Key Rotation (Task-P2-02)
# ============================================================

# Root Key TTL (毫秒，默认 86400000 = 24小时)
ROOT_KEY_TTL_MS=86400000

# 旧 Key 宽限期 (毫秒，默认 3600000 = 1小时)
ROOT_KEY_GRACE_MS=3600000


# ============================================================
# Telemetry (遥测签名)
# ============================================================

# HMAC 共享密钥 - 用于 Agent ↔ Dashboard 心跳签名验证
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
TELEMETRY_SECRET=

# WebSocket 端口
TELEMETRY_WS_PORT=3002

# ============================================================
# Fleet Observer Dashboard
# ============================================================

DASHBOARD_PORT=3001

# ============================================================
# LLM API Keys (用于 Agent 购买算力)
# ============================================================

OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================
# 运行环境
# ============================================================

NODE_ENV=development

# 端口偏移 (若有冲突，设置如 HOST_PORT_PREFIX=1)
# HOST_PORT_PREFIX=
