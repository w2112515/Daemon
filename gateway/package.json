{
    "name": "@daemon/gateway",
    "version": "0.1.0",
    "description": "L402 Payment Gateway for AI Agents",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "l402",
        "lightning",
        "bitcoin",
        "macaroon",
        "payment",
        "ai-agent"
    ],
    "author": "Daemon Team",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "eslint": "^8.55.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^1.1.0"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@types/express": "^4.17.21",
        "express": "^4.18.2",
        "redis": "^5.10.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
